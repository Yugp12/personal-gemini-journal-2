# ==============================================================================
# Server-Side Environment Variables (Vercel / Cloud Run / Node Server)
# ==============================================================================

# Gemini AI Model Configuration
GEMINI_MODEL=gemini-3.7-flash

# Google Cloud Secret Manager (Optional: for runtime secret retrieval)
GEMINI_SECRET_NAME=GEMINI_API_KEY
GEMINI_SECRET_VERSION=latest
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Fallback Gemini API Key (If not using GCP Secret Manager)
GEMINI_API_KEY=your_gemini_api_key_here

# Server & Application Runtime Settings
PORT=8080
APP_URL=https://personal-gemini-journal-2.vercel.app
NODE_ENV=production

# ==============================================================================
# Client-Side Firebase Configuration (Vite - exposed to browser)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id


