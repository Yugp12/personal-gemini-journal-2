rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all root level and unmapped paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Partitioned user tree: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Journal entries: /users/{userId}/journalEntries/{entryId}
      match /journalEntries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 250
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 50000;
      }

      // Legacy journals path: /users/{userId}/journals/{journalId}
      match /journals/{journalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 250
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 50000;
      }

      // Conversations
      match /conversations/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string;

        match /messages/{messageId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId)
            && request.resource.data.role in ['user', 'assistant', 'model']
            && request.resource.data.content is string;
        }
      }

      // Memories (user specific insights)
      match /memories/{memoryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000;
      }

      // Privacy Vault records: /users/{userId}/vaultRecords/{recordId}
      match /vaultRecords/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 250
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 50000;
      }

      // AI Privacy Policy & Settings: /users/{userId}/privacySettings/{docId}
      match /privacySettings/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId);
      }

      // Context Receipts: /users/{userId}/contextReceipts/{receiptId}
      match /contextReceipts/{receiptId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId);
      }

      // Legacy Privacy Vault: /users/{userId}/vault/{documentId}
      match /vault/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.content is string;
      }
    }
  }
}
